# development (local) or production (live site)
ENVIRONMENT=development

LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-claude-key
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
OFFICER_REVIEW_LIMIT=50000

# Secret for officer endpoints. Production needs 24+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OFFICER_API_KEY=change-me

# ChromaDB: local (folder, no account) or cloud (Chroma Cloud: trychroma.com -> API key, tenant, database)
CHROMA_MODE=local
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Websites allowed to call the API (comma separated). Add your live frontend URL in production.
CORS_ORIGINS=http://localhost:3000

# Rate limits per IP address, per minute
RATE_LIMIT_SUBMIT_PER_MIN=5
RATE_LIMIT_READ_PER_MIN=60
RATE_LIMIT_OFFICER_PER_MIN=60

# Safety cap: total new claims per 24 hours for the whole site (protects the LLM bill)
MAX_CLAIMS_PER_DAY=200

# Proxies in front of the API: 0 = none (local / Docker), 1 = Render, Railway, Nginx...
# Used to find the real user IP for rate limits. Users can fake X-Forwarded-For, so never set it higher than real.
TRUSTED_PROXY_HOPS=0

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=insurance-claim-agent
